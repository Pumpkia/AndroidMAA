{
    // ============================================================
    // QQ 登录 Pipeline
    // ============================================================
    // 使用前请用 ImageCropper 截取 QQ 登录界面的关键元素：
    //   1. 账号输入框区域 → 保存为 "账号输入框.png"
    //   2. 密码输入框区域 → 保存为 "密码输入框.png"
    //   3. 登录按钮       → 保存为 "登录按钮.png"
    //   4. 账号密码登录入口 → 保存为 "账号密码登录.png"（若有二维码切换）
    //   5. 已登录状态标识 → 保存为 "已登录.png"（可选，用于判断）
    //
    // 截图方法：打开 QQ 登录窗口 → 用 ImageCropper 连接 Win32
    // → 左键框选 → 按 S 保存到 ./dst/ → 复制到 assets/resource/image/
    // ============================================================

    // ----------------------------------------------------------
    // 入口：完整登录流程
    // ----------------------------------------------------------
    "QQLogin": {
        "next": [
            "检查是否已登录",
            "检测登录窗口",
            "打开QQ"
        ]
    },

    // ----------------------------------------------------------
    // 第 0 步：打开 QQ（如果还没运行）
    // ----------------------------------------------------------
    "打开QQ": {
        "action": "StartApp",
        "package": "com.tencent.mobileqq",
        "next": [
            "等待窗口出现",
            "检测登录窗口"
        ]
    },

    // ----------------------------------------------------------
    // 等待 QQ 窗口出现
    // ----------------------------------------------------------
    "等待窗口出现": {
        "action": "DoNothing",
        "next": [
            "等待窗口出现",
            "检测登录窗口"
        ],
        "on_error": [
            "等待窗口出现"
        ],
        "timeout": 30000,
        "recognition": "TemplateMatch",
        "template": "登录按钮.png"
    },

    // ----------------------------------------------------------
    // 第 1 步：确认我们看到了 QQ 登录界面
    // ----------------------------------------------------------
    "检测登录窗口": {
        "recognition": "OCR",
        "expected": "登录",
        "action": "DoNothing",
        "next": [
            "检查是否已登录",
            "切换到账号密码登录"
        ],
        "on_error": [
            "打开QQ"
        ]
    },

    // ----------------------------------------------------------
    // 第 1.5 步：检查是不是已经登录了
    // ----------------------------------------------------------
    "检查是否已登录": {
        "recognition": "TemplateMatch",
        "template": "已登录.png",
        "action": "DoNothing",
        "next": [
            "已登录无需操作"
        ],
        "on_error": [
            "检测登录窗口"
        ]
    },

    "已登录无需操作": {
        "action": "StopTask",
        "next": []
    },

    // ----------------------------------------------------------
    // 第 2 步：如果显示二维码，切换到账号密码登录
    // 新版 QQ 默认显示二维码，需要点一下切换到账号密码
    // ----------------------------------------------------------
    "切换到账号密码登录": {
        "recognition": "TemplateMatch",
        "template": "账号密码登录.png",
        "action": "Click",
        "next": [
            "点击账号输入框"
        ],
        "on_error": [
            "点击账号输入框"
        ]
    },

    // ----------------------------------------------------------
    // 第 3 步：点击账号输入框，清空旧内容，输入账号
    // ----------------------------------------------------------
    "点击账号输入框": {
        "recognition": "TemplateMatch",
        "template": "账号输入框.png",
        "action": "Click",
        "next": [
            "输入账号"
        ]
    },

    "输入账号": {
        "action": "InputText",
        // 默认占位值可由 ProjectInterface 的 QQ账号 option 覆盖
        "input_text": "你的QQ号",
        "next": [
            "点击密码输入框"
        ]
    },

    // ----------------------------------------------------------
    // 第 4 步：点击密码输入框，输入密码
    // 说明：QQ 登录界面一般点击账号框后密码框自动获得焦点，
    // 按 Tab 可以切换。如果你的 QQ 版本需要额外点击密码框，
    // 请取消下面"点击密码输入框"的注释。
    // ----------------------------------------------------------
    "点击密码输入框": {
        "action": "ClickKey",
        "key": 61,
        "next": [
            "输入密码"
        ]
    },

    "输入密码": {
        "action": "InputText",
        // 默认占位值可由 ProjectInterface 的 QQ密码 option 覆盖
        "input_text": "你的QQ密码",
        "next": [
            "勾选记住密码",
            "点击登录按钮"
        ]
    },

    // ----------------------------------------------------------
    // 第 5 步（可选）：勾选"记住密码"和"自动登录"
    // ----------------------------------------------------------
    "勾选记住密码": {
        "recognition": "OCR",
        "expected": "记住密码",
        "action": "Click",
        "next": [
            "勾选自动登录",
            "点击登录按钮"
        ],
        "on_error": [
            "点击登录按钮"
        ]
    },

    "勾选自动登录": {
        "recognition": "OCR",
        "expected": "自动登录",
        "action": "Click",
        "next": [
            "点击登录按钮"
        ],
        "on_error": [
            "点击登录按钮"
        ]
    },

    // ----------------------------------------------------------
    // 第 6 步：点击登录按钮
    // ----------------------------------------------------------
    "点击登录按钮": {
        "recognition": "OCR",
        "expected": "登录",
        "action": "Click",
        "next": [
            "等待登录完成"
        ],
        "on_error": [
            "备用登录按钮"
        ]
    },

    // 备用：用模板匹配找登录按钮
    "备用登录按钮": {
        "recognition": "TemplateMatch",
        "template": "登录按钮.png",
        "action": "Click",
        "next": [
            "等待登录完成"
        ]
    },

    // ----------------------------------------------------------
    // 第 7 步：等待登录结果
    // ----------------------------------------------------------
    "等待登录完成": {
        "action": "DoNothing",
        "next": [
            "等待登录完成",
            "登录成功"
        ],
        "timeout": 10000
    },

    // 用模板匹配检查是否登录成功（比如出现了主面板）
    "登录成功": {
        "recognition": "TemplateMatch",
        "template": "登录成功标志.png",
        "action": "DoNothing",
        "next": [],
        "on_error": [
            "等待登录完成"
        ]
    },

    // ============================================================
    // 快捷入口：只做切换+输入（不点登录）
    // ============================================================
    "SwitchToPasswordLogin": {
        "next": [
            "切换到账号密码登录"
        ]
    },

    // ============================================================
    // 快捷入口：只输入账号密码（假设已经在账号密码界面）
    // ============================================================
    "EnterCredentials": {
        "next": [
            "点击账号输入框"
        ]
    },

    // ============================================================
    // 快捷入口：只点击登录（假设账号密码已填好）
    // ============================================================
    "ClickLogin": {
        "next": [
            "点击登录按钮"
        ]
    }
}
