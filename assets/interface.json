{
    "interface_version": 2,
    "name": "Qdd",
    "description": "奇迹暖暖自动化 - 基于 MaaFramework",
    "contact": "",
    "license": "MIT",
    "version": "2.1.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720,
            "display_raw": false
        }
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "StartNikki",
            "option": [
                "游戏包名"
            ]
        },
        {
            "name": "每日签到",
            "entry": "DailySignIn"
        },
        {
            "name": "领取体力",
            "entry": "CollectStamina"
        },
        {
            "name": "回到主界面",
            "entry": "GoHome"
        }
    ],
    "option": {
        "游戏包名": {
            "type": "input",
            "label": "游戏包名",
            "description": "奇迹暖暖 Android 包名，可按渠道修改。",
            "inputs": [
                {
                    "name": "包名",
                    "label": "Android 包名",
                    "default": "com.papegames.nn4",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "启动奇迹暖暖": {
                    "package": "{包名}"
                }
            }
        }
    }
}
